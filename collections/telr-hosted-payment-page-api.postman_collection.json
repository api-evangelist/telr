          "request": {
            "name": "Create or check a hosted payment page order",
            "description": {
              "content": "Create a hosted payment page order (method=create) and receive a process.html redirect URL, or check the status of an existing order (method=check) by its order ref. Authenticates with store + authkey in the request body (no HTTP auth header).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gateway",
                "order.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"<string>\",\n  \"store\": \"<integer>\",\n  \"authkey\": \"<string>\",\n  \"order\": {\n    \"ref\": \"<string>\",\n    \"cartid\": \"<string>\",\n    \"test\": \"<integer>\",\n    \"amount\": \"<string>\",\n    \"currency\": \"<string>\",\n    \"description\": \"<string>\",\n    \"trantype\": \"<string>\"\n  },\n  \"return\": {\n    \"authorised\": \"<uri>\",\n    \"declined\": \"<uri>\",\n    \"cancelled\": \"<uri>\"\n  },\n  \"framed\": \"<integer>\",\n  \"customer\": {\n    \"email\": \"<email>\",\n    \"name\": {\n      \"title\": \"<string>\",\n      \"firstName\": \"<string>\",\n      \"lastName\": \"<string>\"\n    },\n    \"address\": {\n      \"line1\": \"<string>\",\n      \"line2\": \"<string>\",\n      \"line3\": \"<string>\",\n      \"city\": \"<string>\",\n      \"country\": \"<string>\"\n    },\n    \"phone\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
