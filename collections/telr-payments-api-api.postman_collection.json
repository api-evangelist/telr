          "name": "Create an order (REST Payments API)",
          "request": {
            "name": "Create an order (REST Payments API)",
            "description": {
              "content": "Newer REST order-creation endpoint. Authenticates with HTTP Basic auth (store id as username, API key as password). Returns the order with hypermedia _links and up to two webhooks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
