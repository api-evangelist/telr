      "item": [
        {
          "id": "1b2c12d7-700f-44e8-916e-8f2a7aecc004",
          "name": "Process a direct (remote) card or wallet transaction",
          "request": {
            "name": "Process a direct (remote) card or wallet transaction",
            "description": {
              "content": "Server-to-server sale/auth transaction. Card details, or an Apple Pay / Google Pay / Samsung Pay wallet token, are submitted directly. Requires appropriate PCI scope for raw card data. Authenticates with store + authkey in the request body.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gateway",
                "remote.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store\": \"<integer>\",\n  \"authkey\": \"<string>\",\n  \"method\": \"<string>\",\n  \"tran\": {\n    \"type\": \"<string>\",\n    \"class\": \"<string>\",\n    \"amount\": \"<string>\",\n    \"currency\": \"<string>\",\n    \"id\": \"<string>\",\n    \"description\": \"<string>\",\n    \"test\": \"<integer>\",\n    \"ref\": \"<string>\"\n  },\n  \"card\": {\n    \"number\": \"<string>\",\n    \"expiry\": {\n      \"month\": \"<integer>\",\n      \"year\": \"<integer>\"\n    },\n    \"cvv\": \"<string>\"\n  },\n  \"applepay\": \"<object>\",\n  \"googlepay\": \"<object>\",\n  \"samsungpay\": \"<object>\",\n  \"customer\": {\n    \"email\": \"<email>\",\n    \"name\": {\n      \"title\": \"<string>\",\n      \"firstName\": \"<string>\",\n      \"lastName\": \"<string>\"\n    },\n    \"address\": {\n      \"line1\": \"<string>\",\n      \"line2\": \"<string>\",\n      \"line3\": \"<string>\",\n      \"city\": \"<string>\",\n      \"country\": \"<string>\"\n    },\n    \"phone\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "36a4bab7-4067-4ece-bdba-0284bb8167ea",
              "name": "Transaction processed (see transaction.status).",
              "originalRequest": {
                "url": {
                  "path": [
                    "gateway",
                    "remote.json"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"store\": \"<integer>\",\n  \"authkey\": \"<string>\",\n  \"method\": \"<string>\",\n  \"tran\": {\n    \"type\": \"<string>\",\n    \"class\": \"<string>\",\n    \"amount\": \"<string>\",\n    \"currency\": \"AED\",\n    \"id\": \"<string>\",\n    \"description\": \"<string>\",\n    \"test\": \"<integer>\",\n    \"ref\": \"<string>\"\n  },\n  \"card\": {\n    \"number\": \"<string>\",\n    \"expiry\": {\n      \"month\": \"<integer>\",\n      \"year\": \"<integer>\"\n    },\n    \"cvv\": \"<string>\"\n  },\n  \"applepay\": \"<object>\",\n  \"googlepay\": \"<object>\",\n  \"samsungpay\": \"<object>\",\n  \"customer\": {\n    \"email\": \"<email>\",\n    \"name\": {\n      \"title\": \"<string>\",\n      \"firstName\": \"<string>\",\n      \"lastName\": \"<string>\"\n    },\n    \"address\": {\n      \"line1\": \"<string>\",\n      \"line2\": \"<string>\",\n      \"line3\": \"<string>\",\n      \"city\": \"<string>\",\n      \"country\": \"<string>\"\n    },\n    \"phone\": \"<string>\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"trace\": \"string\",\n  \"transaction\": {\n    \"ref\": \"string\",\n    \"type\": \"string\",\n    \"class\": \"string\",\n    \"status\": \"string\",\n    \"code\": \"string\",\n    \"message\": \"string\"\n  },\n  \"error\": {\n    \"message\": \"string\",\n    \"note\": \"string\",\n    \"details\": {}\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
